# ===========================================================================
# PMTask — Environment Configuration (template)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# ===========================================================================

# --- Application ----------------------------------------------------------
# Runtime environment: "development" | "production" | "test"
# In production this also enables secure (HTTPS-only) session cookies.
NODE_ENV=development

# Port the HTTP server listens on.
PORT=3000

# --- Database (MySQL) -----------------------------------------------------
# These components are the source of truth. `DATABASE_URL` is assembled from
# them automatically (see src/config/database.js).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=pmtask

# Optional: set a full connection string to override the components above
# (e.g. for a managed/hosted database). Leave blank to use DB_* values.
# DATABASE_URL="mysql://user:pass@host:3306/dbname"

# --- Session --------------------------------------------------------------
# Secret used to sign session cookies. MUST be a long, random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Google OAuth 2.0 (optional) ------------------------------------------
# Leave blank to disable "Sign in with Google".
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
