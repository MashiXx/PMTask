<%- include('partials/head', { title: 'Dashboard' }) %>

<div class="app-layout">
  <%- include('partials/sidebar') %>

  <main class="main-content">
    <%- include('partials/header') %>

    <div class="dashboard-body">
      <%- include('partials/stats') %>
      <%- include('partials/kanban') %>
      <%- include('partials/list-view') %>
    </div>
  </main>
</div>

<%- include('partials/modals/task-modal') %>
<%- include('partials/modals/delete-modal') %>
<%- include('partials/modals/project-modal') %>
<%- include('partials/modals/task-preview-modal') %>
<%- include('partials/modals/tag-modal') %>
<%- include('partials/modals/group-modal') %>

<script>
window.PROJECT_TAGS = <%- JSON.stringify(projectTags || []).replace(/<\//g, '<\\/') %>;
window.IS_GUEST = <%= typeof isGuest !== 'undefined' && isGuest ? 'true' : 'false' %>;
window.CURRENT_USER_ID = <%= typeof currentUser !== 'undefined' && currentUser ? currentUser.id : 'null' %>;
window.IS_ADMIN = <%= typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin' ? 'true' : 'false' %>;
<% if (typeof activeProject !== 'undefined' && activeProject) { %>window.ACTIVE_PROJECT_SLUG = '<%= activeProject.id %>-<%= activeProject.slug %>';<% } %>
</script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script src="/js/task-attachments.js"></script>
<script src="/js/modal.js"></script>
<script src="/js/project.js"></script>
<script src="/js/kanban.js"></script>
<script src="/js/search.js"></script>
<script src="/js/tag-filter.js"></script>
<script src="/js/tag-manage.js"></script>
<script src="/js/group-manage.js"></script>
<script src="/js/task-status.js"></script>
<script src="/js/subtask.js"></script>
<script src="/js/comment.js"></script>
<script src="/js/view-toggle.js"></script>

<%- include('partials/foot') %>
