<%- include('../partials/head', { title: 'Mindmaps' }) %>
<link rel="stylesheet" href="/css/mindmap.css">

<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="topbar">
      <button class="mobile-menu-btn" onclick="toggleSidebar()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="topbar-left">
        <div class="breadcrumb"><span class="breadcrumb-current"><%= activeProject.name %> · Mindmaps</span></div>
      </div>
    </div>

    <div class="mm-list-wrap">
      <div class="mm-list-head">
        <span class="mm-list-title">Mindmaps</span>
        <button class="btn-new-task" onclick="createMindmap()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New mindmap
        </button>
      </div>

      <input type="hidden" id="mmProjectId" value="<%= activeProjectId %>">
      <input type="hidden" id="mmProjectSlug" value="<%= activeProject.id %>-<%= activeProject.slug %>">

      <% if (mindmaps.length === 0) { %>
        <p class="mm-empty">No mindmaps yet. Create one to start mapping ideas.</p>
      <% } %>

      <div class="mm-grid" id="mmGrid">
        <% mindmaps.forEach(m => { %>
          <a class="mm-card" href="/projects/<%= activeProject.id %>-<%= activeProject.slug %>/mindmaps/<%= m.id %>" data-mm-id="<%= m.id %>">
            <span class="mm-card-name"><%= m.name %></span>
            <span class="mm-card-meta"><%= m._count.nodes %> node<%= m._count.nodes === 1 ? '' : 's' %></span>
            <span class="mm-card-actions">
              <button onclick="event.preventDefault(); renameMindmap(<%= m.id %>, '<%= m.name.replace(/'/g, "\\'") %>')">Rename</button>
              <button onclick="event.preventDefault(); deleteMindmap(<%= m.id %>)">Delete</button>
            </span>
          </a>
        <% }) %>
      </div>
    </div>
  </main>
</div>

<script src="/js/mm-ui.js"></script>
<script src="/js/mindmap-list.js"></script>
<%- include('../partials/foot') %>
