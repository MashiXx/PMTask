<%- include('partials/head', { title: task.title }) %>

<%
  const avatarColors = ['#2D6FE0', '#2B9CD8', '#EF4444', '#1E9E60', '#F59E0B'];
  function fmtDue(d) {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(d || '').trim());
    return m ? (parseInt(m[3], 10) + ' Th' + parseInt(m[2], 10) + ', ' + m[1]) : d;
  }
  const _created = new Date(task.createdAt);
  const _days = Math.floor((Date.now() - _created.getTime()) / 86400000);
  const createdLabel = _days <= 0 ? t('task.relativeToday') : _days === 1 ? t('task.relativeYesterday')
    : _days < 30 ? t('task.relativeDaysAgo', { n: _days })
    : _days < 365 ? t('task.relativeMonthsAgo', { n: Math.floor(_days / 30) })
    : t('task.relativeYearsAgo', { n: Math.floor(_days / 365) });
  const subDoneCount = task.subtasks.filter(s => s.done).length;
  const subPercent = task.status === 'done' ? 100
    : (task.subtasks.length ? Math.round(subDoneCount / (task.subtasks.length + 1) * 100) : (task.progress || 0));
%>

<div class="app-layout">
  <%- include('partials/sidebar') %>

  <main class="main-content">
    <div class="topbar">
      <button class="mobile-menu-btn" onclick="toggleSidebar()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="topbar-left">
        <div class="breadcrumb">
          <a href="/dashboard/<%= task.project.id %>-<%= task.project.slug %>" class="breadcrumb-text breadcrumb-link">
            <%= task.project.name %>
          </a>
          <span class="breadcrumb-separator">/</span>
          <span class="breadcrumb-text"><%= task.title %></span>
        </div>
      </div>
      <div class="topbar-right">
        <button class="theme-toggle-btn" onclick="cycleTheme()" title="<%= t('common.toggleTheme') %>">
          <svg class="theme-icon theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="theme-icon theme-icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="theme-icon theme-icon-system" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </button>
        <% if (currentUser) { %>
          <button class="btn-delete" onclick="deleteTask(<%= task.id %>)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            <%= t('common.delete') %>
          </button>
        <% } else { %>
          <a href="/auth/login" class="btn-new-task no-decoration"><%= t('sidebar.login') %></a>
        <% } %>
      </div>
    </div>

    <div class="dashboard-body">
      <div class="task-detail">
        <!-- MAIN COLUMN -->
        <div class="task-detail-main">
          <!-- Title + completion dot -->
          <div class="task-detail-title-row">
            <% if (canEdit) { %>
              <input type="text" id="detailTitle" class="task-detail-title-input" value="<%= task.title %>" data-task-id="<%= task.id %>">
              <button type="button" id="detailDoneToggle" class="title-done-check <%= task.status === 'done' ? 'is-done' : '' %>" onclick="toggleDetailDone()" title="<%= t('task.markDone') %>" aria-label="<%= t('task.markDone') %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
            <% } else { %>
              <h1 class="task-detail-title"><%= task.title %></h1>
            <% } %>
          </div>

          <!-- Meta: members / priority / due date -->
          <div class="preview-meta-row">
            <div class="preview-meta-item">
              <span class="preview-meta-label"><%= t('task.members') %></span>
              <div class="preview-meta-control">
                <% if (task.assignees.length > 0) { %>
                  <div class="preview-avatars">
                    <% task.assignees.forEach((a, i) => { %>
                      <% const aColor = avatarColors[i % avatarColors.length]; %>
                      <div class="preview-avatar" style="background: <%= aColor %>; color:#fff;" title="<%= a.user.name %>"><%- include('partials/avatar', { avatarUser: a.user }) %></div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <span class="preview-avatars-empty"><%= t('task.noMembers') %></span>
                <% } %>
              </div>
            </div>

            <div class="preview-meta-item">
              <span class="preview-meta-label"><%= t('task.priority') %></span>
              <div class="preview-meta-control">
                <div class="preview-pill-select-wrap">
                  <span class="preview-priority-pill" id="detailPriorityPill" data-priority="<%= task.priority %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                    <span id="detailPriorityText"><%= t('task.priority' + task.priority.charAt(0).toUpperCase() + task.priority.slice(1)) %></span>
                  </span>
                  <% if (canEdit) { %>
                    <select id="detailPrioritySelect" class="preview-overlay-select" data-task-id="<%= task.id %>" aria-label="<%= t('task.priority') %>">
                      <option value="low" <%= task.priority === 'low' ? 'selected' : '' %>><%= t('task.priorityLow') %></option>
                      <option value="medium" <%= task.priority === 'medium' ? 'selected' : '' %>><%= t('task.priorityMedium') %></option>
                      <option value="high" <%= task.priority === 'high' ? 'selected' : '' %>><%= t('task.priorityHigh') %></option>
                    </select>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="preview-meta-item">
              <span class="preview-meta-label"><%= t('task.dueDate') %></span>
              <div class="preview-meta-control">
                <% if (canEdit) { %>
                  <label class="preview-date-chip detail-date-chip">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <input type="date" id="detailDueDate" value="<%= task.dueDate || '' %>" data-task-id="<%= task.id %>">
                  </label>
                <% } else { %>
                  <span class="preview-date-chip <%= task.dueDate ? '' : 'preview-date-empty' %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <%= task.dueDate ? fmtDue(task.dueDate) : t('task.dueDateNone') %>
                  </span>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Description -->
          <div class="task-detail-section preview-section">
            <p class="preview-section-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              <%= t('task.description') %>
            </p>
            <% if (canEdit) { %>
              <div id="descriptionRendered" class="task-detail-desc-rendered" title="<%= t('common.edit') %>">
                <% if (task.description) { %>
                  <span class="desc-placeholder-loading"><%= t('documents.loading') %></span>
                <% } else { %>
                  <span class="desc-placeholder"><%= t('task.descPlaceholder') %></span>
                <% } %>
              </div>
              <div id="descriptionEditorWrap" class="task-detail-editor-wrap hidden">
                <textarea id="descriptionEditor"><%= task.description || '' %></textarea>
                <div class="editor-actions">
                  <button type="button" class="btn-editor-save" onclick="saveDescription()">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <%= t('common.save') %>
                  </button>
                  <button type="button" class="btn-editor-cancel" onclick="cancelDescription()"><%= t('common.cancel') %></button>
                </div>
              </div>
            <% } else { %>
              <% if (task.description) { %>
                <div id="descriptionRendered" class="task-detail-desc-rendered">
                  <span class="desc-placeholder-loading"><%= t('documents.loading') %></span>
                </div>
              <% } else { %>
                <p class="task-detail-text" style="color: var(--text-dim);"><%= t('task.noDescription') %></p>
              <% } %>
            <% } %>
          </div>

          <!-- Attachments -->
          <div class="task-detail-section preview-section">
            <p class="preview-section-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
              <%= t('task.attachments') %>
            </p>
            <div class="preview-attach-box">
              <div id="taskAttachmentsList" class="attach-list"></div>
              <% if (canEdit) { %>
                <div id="taskAttachmentDrop" class="attach-dropzone">
                  <input type="file" id="taskAttachmentInput" class="hidden" multiple
                    accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.md,.csv,.json,.xml,.zip,.rar,.7z">
                  <label for="taskAttachmentInput" class="attach-dropzone-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    <%= t('task.dropFilesHere') %> <span class="attach-browse"><%= t('task.browse') %></span>
                  </label>
                </div>
              <% } %>
            </div>
            <% if (canEdit) { %><p class="attach-paste-hint"><%= t('task.pasteTip') %></p><% } %>
          </div>
        </div>

        <!-- SIDEBAR -->
        <aside class="task-detail-sidebar">
          <!-- Checklist -->
          <div class="task-detail-section preview-section preview-checklist">
            <div class="preview-section-head">
              <p class="preview-section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <%= t('task.checklist') %>
                <span class="subtask-count-badge"><%= task.subtasks.length ? subDoneCount + '/' + task.subtasks.length : '' %></span>
              </p>
              <span class="preview-checklist-pct" id="detailProgressText"><%= subPercent %>%</span>
            </div>
            <div class="subtask-progress-bar mb-8">
              <div class="subtask-progress-fill" style="width:<%= task.subtasks.length ? subPercent : 0 %>%;"></div>
            </div>
            <div id="detailSubtaskList" class="subtask-list" data-task-id="<%= task.id %>" data-task-status="<%= task.status %>">
              <% task.subtasks.forEach(sub => { %>
                <div class="subtask-item <%= sub.done ? 'done' : '' %>" data-subtask-id="<%= sub.id %>">
                  <label class="subtask-check">
                    <input type="checkbox" <%= sub.done ? 'checked' : '' %> onchange="toggleDetailSubtask(<%= sub.id %>, this.checked)">
                    <span class="subtask-checkmark"></span>
                  </label>
                  <span class="subtask-title"><%= sub.title %></span>
                  <% if (currentUser) { %>
                    <button class="subtask-delete-btn" onclick="deleteDetailSubtask(<%= sub.id %>)">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                  <% } %>
                </div>
              <% }) %>
            </div>
            <% if (currentUser) { %>
              <div class="subtask-add mt-8">
                <input type="text" id="detailSubtaskInput" class="subtask-input" placeholder="<%= t('task.subtaskPlaceholder') %>" onkeydown="if(event.key==='Enter'){addDetailSubtask(); event.preventDefault();}">
                <button class="subtask-add-btn" onclick="addDetailSubtask()">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
              </div>
            <% } %>
          </div>

          <!-- Comments -->
          <div class="task-detail-section preview-section">
            <p class="preview-section-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <%= t('task.comments') %>
            </p>
            <div id="detailComments" class="comment-list"></div>
          </div>

          <div class="preview-side-footer">
            <p><%= t('task.createdBy') %> <strong><%= task.createdBy ? task.createdBy.name : '—' %></strong></p>
            <p class="preview-side-foot-time"><%= createdLabel %></p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>

<%- include('partials/modals/task-modal') %>
<%- include('partials/modals/delete-modal') %>

<script>
  window.TASK_DATA = {
    id: <%= task.id %>,
    projectId: <%= task.projectId %>,
    description: <%- JSON.stringify(task.description || '').replace(/<\//g, '<\\/').replace(/<!--/g, '<\\!--') %>,
    canEdit: <%= canEdit %>,
    currentUserId: <%= typeof currentUser !== 'undefined' && currentUser ? currentUser.id : 'null' %>,
    isAdmin: <%= typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin' ? 'true' : 'false' %>,
    attachments: <%- JSON.stringify(task.attachments || []).replace(/<\//g, '<\\/') %>
  };
</script>
<%- include('partials/foot') %>

<script src="/js/modal.js"></script>
<script src="/js/subtask.js"></script>
<script src="/js/task-attachments.js"></script>
<script src="/js/comment.js"></script>
<script src="/js/task-detail.js"></script>
<script>
  // Mount attachments UI for the task detail page
  if (window.TaskAttachments && window.TASK_DATA) {
    window.TaskAttachments.mount({
      container: 'taskAttachmentsList',
      fileInput: 'taskAttachmentInput',
      dropZone: 'taskAttachmentDrop',
      taskId: window.TASK_DATA.id,
      canEdit: window.TASK_DATA.canEdit,
      attachments: window.TASK_DATA.attachments,
    });
  }
  if (window.TaskComments && window.TASK_DATA) {
    window.TaskComments.mount({
      container: 'detailComments',
      taskId: window.TASK_DATA.id,
      canEdit: window.TASK_DATA.canEdit,
      currentUserId: window.TASK_DATA.currentUserId,
      isAdmin: window.TASK_DATA.isAdmin,
    });
  }
</script>
<script>
  // Override delete redirect to go back to project
  const origConfirmDelete = confirmDelete;
  confirmDelete = async function() {
    const taskId = document.getElementById('deleteTaskId').value;
    try {
      await fetch('/api/tasks/' + taskId, { method: 'DELETE' });
      window.location.href = '/dashboard/' + <%- JSON.stringify(task.project.id + '-' + task.project.slug) %>;
    } catch (err) {
      console.error('Failed to delete task:', err);
    }
  };
</script>
