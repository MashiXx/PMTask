<div class="stats-sprint-row">
  <div class="stat-count">
    <span class="stat-count-value"><%= stats.total %></span>
    <span class="stat-count-label">Công việc</span>
  </div>

  <div class="stat-chip">
    <span class="stat-chip-icon stat-chip-progress">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
    </span>
    <span class="stat-chip-text"><%= stats.inProgress %> đang làm</span>
  </div>

  <div class="stat-chip">
    <span class="stat-chip-icon stat-chip-done">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg>
    </span>
    <span class="stat-chip-text"><%= stats.completed %> hoàn thành</span>
  </div>

  <% if (stats.overdue > 0) { %>
    <div class="stat-chip">
      <span class="stat-chip-icon stat-chip-overdue">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </span>
      <span class="stat-chip-text"><%= stats.overdue %> quá hạn</span>
    </div>
  <% } %>

  <div class="stat-mini-progress">
    <div class="sprint-track">
      <div class="sprint-fill" style="width:<%= sprintProgress %>%"></div>
    </div>
    <span class="stat-mini-percent"><%= sprintProgress %>%</span>
  </div>
</div>
