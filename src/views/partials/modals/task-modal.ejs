<div class="modal-overlay" id="taskModal">
  <div class="modal">
    <h2 class="modal-title" id="taskModalTitle"><%= t('task.modal.newTask') %></h2>

    <form id="taskForm">
      <input type="hidden" id="taskId" value="">
      <input type="hidden" id="taskProjectId" value="<%= typeof activeProjectId !== 'undefined' ? activeProjectId : '' %>">

      <div class="form-group">
        <label><%= t('task.modal.titleLabel') %></label>
        <input type="text" id="taskTitle" placeholder="<%= t('task.modal.titlePlaceholder') %>" required>
      </div>

      <div class="form-group">
        <label><%= t('task.modal.descLabel') %></label>
        <textarea id="taskDescription" placeholder="<%= t('task.modal.descPlaceholder') %>" rows="2" style="resize:vertical"></textarea>
      </div>

      <div style="display: flex; gap: 12px;">
        <div class="form-group" style="flex:1">
          <label><%= t('task.modal.priorityLabel') %></label>
          <select id="taskPriority">
            <option value="low"><%= t('task.priorityLow') %></option>
            <option value="medium" selected><%= t('task.priorityMedium') %></option>
            <option value="high"><%= t('task.priorityHigh') %></option>
          </select>
        </div>
        <div class="form-group" style="flex:1">
          <label><%= t('task.modal.statusLabel') %></label>
          <select id="taskStatus">
            <option value="todo"><%= t('task.statusTodo') %></option>
            <option value="inprogress"><%= t('task.statusInProgress') %></option>
            <option value="review"><%= t('task.statusInReview') %></option>
            <option value="done"><%= t('task.statusDone') %></option>
          </select>
        </div>
      </div>

      <div style="display: flex; gap: 12px;">
        <div class="form-group" style="flex:1">
          <label><%= t('task.modal.dueDateLabel') %></label>
          <input type="date" id="taskDueDate">
        </div>
        <div class="form-group" style="flex:1">
          <label><%= t('task.modal.progressLabel') %></label>
          <input type="number" id="taskProgress" min="0" max="100" value="0">
        </div>
      </div>

      <% if (typeof projectTags !== 'undefined' && projectTags.length > 0) { %>
        <div class="form-group">
          <label><%= t('task.modal.tagsLabel') %></label>
          <div class="tags-container">
            <% projectTags.forEach(tag => { %>
              <input type="checkbox" class="tag-checkbox" name="tags" value="<%= tag.name %>" id="tag-<%= tag.name %>">
              <label class="tag-label" for="tag-<%= tag.name %>" style="--tag-color: <%= tag.color %>"><%= tag.name.charAt(0).toUpperCase() + tag.name.slice(1) %></label>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeTaskModal()"><%= t('common.cancel') %></button>
        <button type="submit" class="btn-submit" id="taskSubmitBtn"><%= t('task.modal.createTask') %></button>
      </div>
    </form>
  </div>
</div>
