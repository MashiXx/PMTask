<div class="modal-overlay" id="groupManagerModal">
  <div class="modal modal-sm">
    <h2 class="modal-title"><%= t('group.manageGroups') %></h2>

    <div class="group-add-row flex-center gap-8 mb-8">
      <input type="text" id="newGroupName" class="flex-1" placeholder="<%= t('group.newGroupName') %>" autocomplete="off">
      <input type="color" id="newGroupColor" value="#2D6FE0" title="<%= t('group.colorTitle') %>" class="group-color-input">
      <button class="btn-submit" onclick="addNewGroup()" style="padding:8px 14px;"><%= t('group.add') %></button>
    </div>

    <div id="groupList" class="group-manager-list"></div>

    <div class="modal-actions mt-20">
      <button type="button" class="btn-cancel" onclick="closeGroupManager()"><%= t('common.close') %></button>
    </div>
  </div>
</div>
