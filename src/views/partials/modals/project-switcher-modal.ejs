<div class="modal-overlay" id="projectSwitcherModal">
  <div class="modal">
    <h2 class="modal-title">Switch Project</h2>

    <input type="text" id="projectSwitcherSearch" class="project-switcher-search" placeholder="Search projects..." autocomplete="off">

    <div id="projectSwitcherList" class="project-switcher-list">
      <p class="project-switcher-empty">Loading...</p>
    </div>

    <div class="project-switcher-footer">
      <a href="/projects" class="project-switcher-manage no-decoration">All projects</a>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/projects?new=1" class="project-switcher-new no-decoration">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New project
        </a>
      <% } %>
    </div>
  </div>
</div>
