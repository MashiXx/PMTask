<%
  const priorityColors = { high: '#EF4444', medium: '#F59E0B', low: '#1E9E60' };
  const priorityLabels = { high: 'HIGH', medium: 'MED', low: 'LOW' };
  const pColor = priorityColors[task.priority] || '#F59E0B';
  const pLabel = priorityLabels[task.priority] || 'MED';
  const progressColor = task.progress === 100 ? '#1E7C4D' : task.progress > 60 ? '#2D6FE0' : '#F59E0B';
  const avatarColors = ['#2D6FE0', '#2B9CD8', '#EF4444', '#1E7C4D', '#F59E0B'];
  const subDone = task.subtasks ? task.subtasks.filter(s => s.done).length : 0;
  const subTotal = task.subtasks ? task.subtasks.length : 0;
  const subComplete = subTotal > 0 && (subDone === subTotal || task.status === 'done');
%>

<div class="task-card" data-task-id="<%= task.id %>" data-status="<%= task.status %>" data-group-id="<%= task.groupId == null ? '' : task.groupId %>" data-tags="<%= task.tags.map(tt => tt.tag.name).join(',') %>" onclick="openTaskPreview(<%= task.id %>)">
  <div class="task-priority-line" style="background: <%= pColor %>"></div>

  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <button class="task-menu-btn" onclick="event.stopPropagation(); toggleTaskMenu(<%= task.id %>)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
    </button>

    <div class="task-menu" id="menu-<%= task.id %>" onclick="event.stopPropagation()">
      <button class="task-menu-item" onclick="event.stopPropagation(); openEditModal(<%= task.id %>)">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Edit
      </button>
      <button class="task-menu-item danger" onclick="event.stopPropagation(); deleteTask(<%= task.id %>)">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        Delete
      </button>
    </div>
  <% } %>

  <p class="task-title task-drag-handle"><%= task.title %></p>

  <div class="task-meta">
    <div class="task-badges">
      <span class="task-badge badge-priority" style="color: <%= pColor %>; background: <%= pColor %>1f;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
        <%= pLabel %>
      </span>

      <% if (task.dueDate) { %>
        <span class="task-badge badge-due">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <%= task.dueDate %>
        </span>
      <% } %>

      <% if (subTotal > 0) { %>
        <span class="task-badge badge-checklist <%= subComplete ? 'is-complete' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <%= subDone %>/<%= subTotal %>
        </span>
      <% } %>
    </div>

    <% if (task.assignees && task.assignees.length > 0) { %>
      <div class="task-assignees">
        <% task.assignees.forEach((a, i) => { %>
          <% const aColor = avatarColors[i % avatarColors.length]; %>
          <div class="avatar" style="background: <%= aColor %>22; border-color: <%= aColor %>55; color: <%= aColor %>;" title="<%= a.user.name %>"><%- include('avatar', { avatarUser: a.user }) %></div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <% if (task.progress > 0) { %>
    <div class="task-progress-mini">
      <div class="task-progress-mini-track">
        <div class="task-progress-mini-fill" style="width: <%= task.progress %>%; background: <%= progressColor %>; <%= task.progress === 100 ? 'box-shadow: 0 0 8px #1E7C4D55;' : '' %>"></div>
      </div>
      <span class="task-progress-mini-pct" style="color: <%= progressColor %>"><%= task.progress %>%</span>
    </div>
  <% } %>
</div>
