<% var diagramType = (diagram.type || 'mindmap'); var isFreeform = diagramType !== 'mindmap'; %>
<%- include('../partials/head', { title: diagram.name }) %>
<link rel="stylesheet" href="/css/mindmap.css">
<% if (isFreeform) { %><link rel="stylesheet" href="/css/diagram.css"><% } %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="topbar">
      <button class="mobile-menu-btn" onclick="toggleSidebar()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="topbar-left">
        <div class="breadcrumb">
          <a href="/projects/<%= activeProject.id %>-<%= activeProject.slug %>/diagrams" class="breadcrumb-link"><%= t('diagram.title') %></a>
          <span class="breadcrumb-sep">/</span>
          <span class="breadcrumb-text"><%= diagram.name %></span>
        </div>
      </div>
    </div>

    <div class="mm-canvas" id="mmCanvas">
      <% if (isFreeform) { %>
      <div class="mm-toolbar dg-toolbar">
        <div class="dg-tgroup">
          <button class="dg-tbtn" onclick="dgAddNode('rect')"><span class="dg-tglyph">&#9645;</span><span class="dg-tlabel"><%= t('diagram.addBox') %></span></button>
          <% if (diagramType === 'flowchart') { %>
          <button class="dg-tbtn" onclick="dgAddNode('diamond')" title="<%= t('diagram.addDiamond') %>"><span class="dg-tglyph">&#9670;</span></button>
          <button class="dg-tbtn" onclick="dgAddNode('ellipse')" title="<%= t('diagram.addEllipse') %>"><span class="dg-tglyph">&#9711;</span></button>
          <button class="dg-tbtn" onclick="dgAddNode('parallelogram')" title="<%= t('diagram.addParallelogram') %>"><span class="dg-tglyph">&#9649;</span></button>
          <% } %>
          <% if (diagramType === 'architecture') { %>
          <button class="dg-tbtn" onclick="dgAddGroup()" title="<%= t('diagram.addGroup') %>"><span class="dg-tglyph">&#9707;</span></button>
          <% } %>
        </div>
        <div class="dg-tgroup">
          <button class="dg-tbtn" onclick="dgAutoArrange()"><span class="dg-tglyph">&#10070;</span><span class="dg-tlabel"><%= t('diagram.toolbar.arrange') %></span></button>
        </div>
        <div class="dg-tgroup">
          <button class="dg-tbtn" onclick="dgZoom(0.1)" title="<%= t('diagram.toolbar.zoomIn') %>"><span class="dg-tglyph">+</span></button>
          <button class="dg-tbtn" onclick="dgZoom(-0.1)" title="<%= t('diagram.toolbar.zoomOut') %>"><span class="dg-tglyph">&minus;</span></button>
          <button class="dg-tbtn" onclick="dgFit()"><span class="dg-tglyph">&#9633;</span><span class="dg-tlabel"><%= t('diagram.toolbar.fit') %></span></button>
        </div>
        <div class="dg-tgroup">
          <button class="dg-tbtn" onclick="dgUndo()" title="<%= t('diagram.toolbar.undo') %>"><span class="dg-tglyph">&#8630;</span></button>
          <button class="dg-tbtn" onclick="dgRedo()" title="<%= t('diagram.toolbar.redo') %>"><span class="dg-tglyph">&#8631;</span></button>
        </div>
        <div class="dg-tgroup">
          <button class="dg-tbtn" onclick="dgExportPng()"><span class="dg-tglyph">&#11015;</span><span class="dg-tlabel"><%= t('diagram.toolbar.export') %></span></button>
          <button class="dg-tbtn" onclick="dgShowShortcuts()" title="<%= t('diagram.toolbar.shortcuts') %>"><span class="dg-tglyph">?</span></button>
        </div>
      </div>
      <button class="dg-fab" onclick="dgAddNode('rect')" title="<%= t('diagram.addBox') %>" aria-label="<%= t('diagram.addBox') %>">+</button>
      <svg class="mm-svg" id="mmSvg"></svg>
      <div class="mm-viewport" id="mmViewport"></div>
      <% } else { %>
      <div class="mm-toolbar">
        <button onclick="mmAutoArrange()" title="<%= t('mindmap.autoArrange') %>">&#10070;</button>
        <button onclick="mmClearPins()" title="<%= t('mindmap.resetLayout') %>">&#8635;</button>
        <button onclick="mmToggleSearch()" title="<%= t('mindmap.search') %>">&#128269;</button>
        <button onclick="mmZoom(0.1)" title="<%= t('mindmap.zoomIn') %>">+</button>
        <button onclick="mmZoom(-0.1)" title="<%= t('mindmap.zoomOut') %>">&minus;</button>
        <button onclick="mmFit()" title="<%= t('mindmap.resetView') %>">&#9633;</button>
        <button onclick="mmExportPng()" title="<%= t('mindmap.exportPng') %>">&#11015;</button>
        <button onclick="mmToggleHelp()" title="<%= t('mindmap.keyboardShortcuts') %>">?</button>
      </div>
      <div class="mm-search" id="mmSearch" hidden>
        <input type="text" id="mmSearchInput" placeholder="<%= t('mindmap.search') %>" autocomplete="off">
        <span class="mm-search-count" id="mmSearchCount"></span>
      </div>
      <svg class="mm-svg" id="mmSvg"></svg>
      <div class="mm-viewport" id="mmViewport"></div>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/modals/task-preview-modal') %>
<script>
  window.PROJECT_TAGS = [];
  window.IS_GUEST = false;
  window.CURRENT_USER_ID = <%= typeof currentUser !== 'undefined' && currentUser ? currentUser.id : 'null' %>;
  window.IS_ADMIN = <%= typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin' ? 'true' : 'false' %>;
</script>
<script>
  window.MINDMAP = { id: <%= diagram.id %>, projectSlug: '<%= activeProject.id %>-<%= activeProject.slug %>' };
  window.MINDMAP_NAME = <%- JSON.stringify(diagram.name).replace(/</g, '\\u003c') %>;
  window.MINDMAP_NODES = <%- JSON.stringify(nodes).replace(/</g, '\\u003c') %>;
  window.DIAGRAM = { id: <%= diagram.id %>, type: '<%= diagramType %>', projectSlug: '<%= activeProject.id %>-<%= activeProject.slug %>' };
  window.DIAGRAM_EDGES = <%- JSON.stringify(typeof edges !== 'undefined' ? edges : []).replace(/</g, '\\u003c') %>;
</script>
<script src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.13/dist/html-to-image.js"></script>
<% if (isFreeform) { %>
<script src="/js/mm-ui.js"></script>
<script src="/js/mindmap-history.js"></script>
<script src="/js/diagram-clipboard.js"></script>
<script src="/js/diagram.js"></script>
<% } else { %>
<script src="/js/task-attachments.js"></script>
<script src="/js/modal.js"></script>
<script src="/js/subtask.js"></script>
<script src="/js/comment.js"></script>
<script src="/js/mm-ui.js"></script>
<script src="/js/mindmap-layout.js"></script>
<script src="/js/mindmap-color.js"></script>
<script src="/js/mindmap-search.js"></script>
<script src="/js/mindmap-history.js"></script>
<script src="/js/mindmap.js"></script>
<% } %>
<%- include('../partials/foot') %>
